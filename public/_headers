# Cloudflare Pages response headers.
#
# Path prefixes are kept NON-OVERLAPPING on purpose: when two rules match the
# same URL, a duplicated header (Cache-Control in particular) is ambiguous.
#
# /assets/*  Vite's content-hashed bundles. The hash changes whenever the
#            bytes change, so a URL's content is immutable.
# /fonts/*   Version is baked into the filename (…-v2.304-subset.woff2), so
#            the same reasoning applies.
# /static/*  Stable filenames (samples, share card). Week-long TTL with
#            background revalidation.
# /*         Baseline hardening + a content policy that ENFORCES the privacy
#            claim instead of just asserting it: connect-src 'none' means the
#            page cannot open a fetch/XHR/WebSocket to anywhere, so a dropped
#            image has no route off the device even if the code tried.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
