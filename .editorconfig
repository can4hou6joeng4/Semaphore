# EditorConfig for Semaphore
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Cloudflare Pages parses this by leading whitespace — keep it exact
[_headers]
indent_size = 2
trim_trailing_whitespace = true
